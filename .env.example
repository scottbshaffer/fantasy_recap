# Copy to .env and fill in. Never commit .env.

# The number after leagueId= in your ESPN league URL
ESPN_LEAGUE_ID=
# basketball (default) or football; --sport overrides it
ESPN_SPORT=
# Season. Basketball is named by the year it ends (2026-27 is 2027); football by the year it
# starts (the 2026 NFL season is 2026). Leave blank to auto-pick.
ESPN_YEAR=

# Only needed for private leagues. See README for how to find these cookies.
ESPN_S2=
ESPN_SWID=

# --- Who writes the story (all optional) ---
# Without any of these a plain template story is used.
#
# FANTASY_RECAP_PROVIDER picks one: anthropic, claude-code, codex, openai, openai-compatible or
# template. Leave it blank (or "auto") to use the first one available, in this order:
# FANTASY_RECAP_BASE_URL, ANTHROPIC_API_KEY, OPENAI_API_KEY, the claude CLI, the codex CLI.
FANTASY_RECAP_PROVIDER=
# Model id for whichever provider is used. Defaults: claude-sonnet-5-5 for anthropic and
# claude-code, gpt-6.1-terra for openai, Codex's own default for codex. Required for openai-compatible.
FANTASY_RECAP_MODEL=

# anthropic: Claude through the Anthropic API.
ANTHROPIC_API_KEY=

# claude-code: uses your existing Claude Code login (`claude auth login`). No key needed.
# codex: uses your existing Codex login (run `codex login`). No key needed.
# Set these only if the commands aren't on your PATH (common under cron).
FANTASY_RECAP_CLAUDE_BIN=
FANTASY_RECAP_CODEX_BIN=
# Seconds to wait for the claude or codex command (default 300).
FANTASY_RECAP_TIMEOUT=

# openai: the OpenAI API. Needs `pip install openai`.
OPENAI_API_KEY=

# openai-compatible: any server with an OpenAI-style API. Needs `pip install openai`.
# OpenRouter: https://openrouter.ai/api/v1   Ollama: http://localhost:11434/v1
FANTASY_RECAP_BASE_URL=
# The key for that server (blank for local servers like Ollama). OPENAI_API_KEY is never sent there.
FANTASY_RECAP_API_KEY=
