# Copy to .env and fill in. Never commit .env.

# The number after leagueId= in your ESPN league URL
ESPN_LEAGUE_ID=
# Season, named by the year it ends: the 2026-27 season is 2027. Leave blank to auto-pick.
ESPN_YEAR=

# Only needed for private leagues. See README for how to find these cookies.
ESPN_S2=
ESPN_SWID=

# Optional: lets Claude write the story. Without it a plain template story is used.
ANTHROPIC_API_KEY=
# Optional: Claude model id (default claude-sonnet-5-5)
FANTASY_RECAP_MODEL=
